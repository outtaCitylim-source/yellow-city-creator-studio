# Yellow City Creator Studio - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# ============================================
# Application
# ============================================
VITE_APP_NAME=Yellow City Creator Studio
VITE_API_URL=http://localhost:3000/api
NODE_ENV=development

# ============================================
# Database (PostgreSQL)
# ============================================
# Format: postgresql://username:password@localhost:5432/database_name
# For Vercel Postgres: Get from Vercel dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/yellow_city_dev

# ============================================
# Authentication (JWT)
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# ============================================
# Vercel Functions
# ============================================
# These are set automatically by Vercel in production
# VERCEL_ENV=production
# VERCEL_URL=https://your-app.vercel.app

# ============================================
# Email (Optional - for future notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# Analytics (Optional)
# ============================================
VITE_ANALYTICS_ID=your-analytics-id

# ============================================
# Admin Credentials (Development Only)
# ============================================
# For seeding initial admin user
ADMIN_EMAIL=admin@yellowcity.local
ADMIN_PASSWORD=change-me-in-production
