# Yellow City Creator Studio — Environment Variables
# 
# IMPORTANT: Never commit this file or .env.local to GitHub
# Copy to .env.local and fill in your values for local development
# For production, set variables in Vercel dashboard

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/yellow_city_studio
# Vercel Postgres: postgresql://user:password@ep-xxx.vercel-storage.com/verceldb
# Neon: postgresql://user:password@ep-xxx.neon.tech/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/yellow_city_studio

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT secret for signing authentication tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Use a strong, unique value. Change in production.
JWT_SECRET=your-random-secret-key-here-change-this-in-production

# JWT token expiration time
JWT_EXPIRY=7d

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application name
VITE_APP_NAME=Yellow City Creator Studio

# Node environment: development, production, test
NODE_ENV=development

# API base URL (used by frontend to call backend)
# Local: http://localhost:5173
# Production: https://your-domain.vercel.app
VITE_API_URL=http://localhost:5173

# ============================================================================
# ADMIN CREDENTIALS (Development Only)
# ============================================================================

# Initial admin user for seeding database
ADMIN_EMAIL=admin@yellowcity.local
ADMIN_PASSWORD=admin123

# ============================================================================
# EMAIL SERVICE (Resend)
# ============================================================================

# Resend API key for sending transactional emails
RESEND_API_KEY=re_your_resend_api_key_here

# Alternative: SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
# SENDGRID_FROM_EMAIL=noreply@yellowcity.local

# ============================================================================
# PAYMENT PROCESSING (Stripe)
# ============================================================================

# Stripe API keys for payment processing
STRIPE_PUBLIC_KEY=pk_live_your_public_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend Stripe key
VITE_STRIPE_PUBLIC_KEY=pk_live_your_public_key_here

# ============================================================================
# SMS NOTIFICATIONS (Twilio - Optional)
# ============================================================================

# Twilio configuration for SMS notifications
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# ============================================================================
# ANALYTICS (Built-in)
# ============================================================================

# Analytics endpoint for tracking
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# ============================================================================
# VERCEL DEPLOYMENT (Auto-set by Vercel)
# ============================================================================

# These are automatically set by Vercel in production
# VERCEL_ENV=production
# VERCEL_URL=https://your-app.vercel.app

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. Local Development Setup:
#    cp .env.example .env.local
#    nano .env.local  # Edit with your values
#    npm install
#    npm run dev

# 2. Database Setup:
#    createdb yellow_city_studio
#    node api/migrations/run.js
#    node api/seed.js

# 3. Generate JWT Secret:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 4. Stripe Setup (if using payments):
#    - Go to https://stripe.com
#    - Create account and get API keys
#    - Add STRIPE_PUBLIC_KEY and STRIPE_SECRET_KEY
#    - Set up webhook endpoint

# 5. Email Service Setup:
#    - Go to https://resend.com
#    - Create account and get API key
#    - Add RESEND_API_KEY

# 6. Vercel Deployment:
#    - Go to Vercel dashboard
#    - Select project
#    - Settings → Environment Variables
#    - Add each required variable
#    - Redeploy

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================

# Before deploying to production:
# [ ] JWT_SECRET is strong (32+ random characters)
# [ ] DATABASE_URL uses SSL connection
# [ ] ADMIN_PASSWORD is changed from default
# [ ] All secrets are in Vercel, not in code
# [ ] .env.local is in .gitignore
# [ ] No secrets in git history
# [ ] CORS is restricted to your domain
# [ ] HTTPS is enforced
# [ ] Database backups are enabled

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# "Database connection failed"
# - Check DATABASE_URL format
# - Verify PostgreSQL is running
# - Test: psql $DATABASE_URL -c "SELECT 1"

# "JWT token invalid"
# - Regenerate JWT_SECRET
# - Restart dev server
# - Clear browser cookies

# "API returns 500 error"
# - Check Vercel logs: vercel logs
# - Verify environment variables are set
# - Check database is initialized

# "Port already in use"
# - Kill process: lsof -i :5173 && kill -9 <PID>
# - Or use different port: npm run dev -- --port 5174

# ============================================================================
# RESOURCES
# ============================================================================

# PostgreSQL: https://www.postgresql.org/docs
# Vercel: https://vercel.com/docs
# Node.js: https://nodejs.org/docs
# GitHub: https://github.com/outtaCitylim-source/yellow-city-creator-studio
